{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kenote",
  "version": "0.1.0",
  "identifier": "com.kenote.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kenote",
        "width": 520,
        "height": 720,
        "minWidth": 380,
        "minHeight": 450,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {}
  }
}
